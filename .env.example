# Docker-local default. Replace with the deployed Aelora HTTPS URL at a real site.
AELORA_BASE_URL="http://host.docker.internal:3000"
AELORA_GATEWAY_HOST="127.0.0.1"
AELORA_GATEWAY_PORT="4100"
AELORA_GATEWAY_DB="data/gateway.db"
AELORA_GATEWAY_RELOAD="false"

# Keep false for a localhost-only gateway. Set true only when exposing the demo
# console through HTTPS, and then provide separate console-only credentials.
AELORA_GATEWAY_PUBLIC_DEMO="false"
AELORA_GATEWAY_CONSOLE_USERNAME=""
AELORA_GATEWAY_CONSOLE_PASSWORD=""
